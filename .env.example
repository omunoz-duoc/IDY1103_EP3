# Copia este archivo como .env para cambiar valores (todos tienen un valor por defecto).
# Recursos fijos para CADA base de datos (afectan directamente los tiempos medidos)
DB_CPUS=2
DB_RAM=2g
# Credenciales del administrador (solo para este ambiente de laboratorio)
PG_USER=dba
PG_PASSWORD=Salud360_dba
MONGO_USER=dba
MONGO_PASSWORD=Salud360_dba
# Puertos expuestos al equipo anfitrión (pgAdmin / MongoDB Compass)
PG_PORT=5432
MONGO_PORT=27017
